{
  "name": "vayuguide",
  "version": "1.0.0",
  "description": "GenAI-powered interactive web dashboard & lifestyle assistant for winter smog & urban air pollution in India",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5173",
    "serve": "python3 -m http.server 4173",
    "build:esm": "esbuild VayuGuide.jsx --bundle --outfile=VayuGuide.esm.js --format=esm --jsx=transform --external:react --external:react-dom --external:lucide-react",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.1",
    "vitest": "^5.1.2"
  }
}
